h2 = saml_sudo_reauth_title
p.nodata style="font-size: 1em;" = saml_sudo_reauth_text

#saml-sudo-reauth
  = form_with url: saml_sudo_reauth_path, method: :post, local: true, id: 'saml-sudo-reauth-form' do |f|
    = f.hidden_field :back_url, value: @saml_sudo_return_url, id: nil
    = f.button saml_sudo_reauth_button_label, type: 'submit'
