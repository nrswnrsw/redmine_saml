h2 = saml_sudo_reauth_title
p.nodata style="font-size: 1em;" = saml_sudo_reauth_text

/ When the request that triggered this confirmation carried input, it is sealed
/ into an opaque continuation the browser keeps in the sessionStorage of this
/ tab while it visits the IdP. The transaction then returns to the resume page
/ instead of straight to the back URL. Without the continuation nothing here
/ changes, which is also what a GET request and the modal keep doing.
- if @saml_sudo_continuation.present?
  - content_for :header_tags do
    = javascript_include_tag 'saml_sudo_continuation', plugin: 'redmine_saml'

#saml-sudo-reauth
  = form_with url: saml_sudo_reauth_path, method: :post, local: true, id: 'saml-sudo-reauth-form',
              data: { saml_sudo_stash_key: @saml_sudo_continuation_key,
                      saml_sudo_stash: @saml_sudo_continuation } do |f|
    = f.hidden_field :back_url, value: @saml_sudo_return_url, id: nil
    = f.button saml_sudo_reauth_button_label, type: 'submit'
